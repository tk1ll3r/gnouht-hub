# Copy to .env.local for development (or run `node scripts/dev-env.mjs`, which fills it from the local stack).
# In production set these in Vercel with `vercel env add` — never commit real values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role ("secret") key: server-only, bypasses RLS.
SUPABASE_SECRET_KEY=

APP_URL=http://localhost:3000

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENC_KEY=
APP_ENC_KEY_VERSION=1
# During key rotation only:
# APP_ENC_KEY_PREVIOUS=
# APP_ENC_KEY_PREVIOUS_VERSION=

# Bearer secret for /api/cron/* (also stored in Supabase Vault as hub_cron_secret)
CRON_SECRET=

# Google OAuth client (Calendar); leave empty to hide Google features
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (email digests and invites)
RESEND_API_KEY=
EMAIL_FROM=gnouht hub <noreply@gnouht.space>
